{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "RushLink desktop window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:deny-default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://ko-fi.com/mattc_" }]
    }
  ]
}
