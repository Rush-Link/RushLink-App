{
   "action": {
      "default_title": "Headrush Companion"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "https://headrush.zybler.se/*", "http://localhost:3456/*", "http://127.0.0.1:3456/*" ],
      "run_at": "document_start"
   } ],
   "description": "Local-network connector that lets headrush.zybler.se communicate with your Headrush pedal.",
   "externally_connectable": {
      "matches": [ "https://headrush.zybler.se/*", "http://localhost:3456/*", "http://127.0.0.1:3456/*" ]
   },
   "host_permissions": [ "http://*.local/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Headrush Companion",
   "permissions": [ "storage", "sidePanel" ],
   "side_panel": {
      "default_path": "popup.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.60"
}
